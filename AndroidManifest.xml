<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.lengroo.pddlg"
    android:versionCode="78"
    android:versionName="1.0.23">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Serves the tuning values to the module code inside PDD (see
             ConfigProvider). Exported and read-only: the values are plain
             dp numbers, not secrets. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.lengroo.pddlg.config"
            android:exported="true" />
    </application>

</manifest>
