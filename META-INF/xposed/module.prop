minApiVersion=102
targetApiVersion=102
exceptionMode=protective
staticScope=true
# libxposed API 102 code hot reload (shipped in 1.0.21): updating the
# module while Pinduoduo is running replaces the code in place, no
# force-stop. onHotReloaded does a full takeover — unhooks every old
# hook, resolves HostApp itself (the framework does not replay
# onModuleLoaded/onPackageLoaded), re-registers the new hooks,
# reinstalls the pill and restores the saved tab index. The install
# strips any previous generation's host (by class name), resets every
# leftover translation before measuring, and refuses garbage bounds.
autoHotReload=true
